{
  "name": "rafeeq",
  "private": true,
  "description": "Rafeeq — Bidec's services and gifts marketplace for pilgrims",
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker compose up -d postgres redis",
    "db:migrate": "npm run db:migrate -w apps/api",
    "seed": "npm run seed -w apps/api",
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web"
  }
}
