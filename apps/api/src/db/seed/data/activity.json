    {
      "key": "banner-luggage",
      "kind": "banner",
      "link": "rafeeq://services?category=luggage",
      "title": {
        "en": "Travel light: we take your bags to the airport",
        "ar": "سافر بخفة: ننقل أمتعتك إلى المطار",
        "ur": "ہلکے سفر کریں: ہم آپ کا سامان ایئرپورٹ پہنچائیں گے",
        "id": "Bepergian ringan: koper Anda kami antar ke bandara",
        "ms": "Kembara ringan: beg anda kami hantar ke lapangan terbang",
        "tr": "Hafif seyahat edin: bavullarınızı havalimanına biz götürelim"
      },
      "body": {
        "en": "Every handover is scanned and shown in the app."
      }
    },
    {
      "key": "banner-dates",
      "kind": "banner",
      "link": "rafeeq://shop?section=dates",
      "title": {
        "en": "Madinah dates, delivered to your hotel or home",
        "ar": "تمور المدينة إلى فندقك أو بيتك",
        "ur": "مدینہ کی کھجوریں ہوٹل یا گھر تک",
        "id": "Kurma Madinah, diantar ke hotel atau rumah",
        "ms": "Kurma Madinah, dihantar ke hotel atau rumah",
        "tr": "Medine hurması, otelinize veya evinize"
      }
    },
    {
      "key": "banner-wheelchair",
      "kind": "banner",
      "link": "rafeeq://services?category=accessibility",
      "title": {
        "en": "Wheelchair help from your hotel to the Haram",
        "ar": "مساعدة بالكرسي المتحرك من فندقك إلى الحرم",
        "ur": "ہوٹل سے حرم تک وہیل چیئر مدد",
        "id": "Bantuan kursi roda dari hotel ke Masjidil Haram",
        "ms": "Bantuan kerusi roda dari hotel ke Masjidil Haram",
        "tr": "Otelinizden Harem'e tekerlekli sandalye yardımı"
      }
    },
    {
      "key": "help-lost",
      "kind": "help",
      "title": {
        "en": "If you get separated from your group",
        "ar": "إذا انفصلت عن مجموعتك",
        "ur": "اگر آپ اپنے گروپ سے بچھڑ جائیں",
        "id": "Jika terpisah dari rombongan",
        "ms": "Jika terpisah daripada kumpulan",
        "tr": "Grubunuzdan ayrılırsanız"
      },
      "body": {
        "en": "Press \"I'm lost\" on the home screen. Rafeeq sends your location to your group, by SMS if there is no internet. Stay where you are, or walk to the nearest lost-and-found office shown on the map.",
        "ar": "اضغط \"أنا تائه\" في الشاشة الرئيسية. يرسل رفيق موقعك إلى مجموعتك، برسالة نصية إن لم يتوفر الإنترنت. ابقَ مكانك أو توجّه إلى أقرب مكتب مفقودات على الخريطة.",
        "id": "Tekan \"Saya tersesat\" di layar utama. Rafeeq mengirim lokasi Anda ke rombongan, lewat SMS jika tidak ada internet. Tetap di tempat, atau berjalan ke kantor barang hilang terdekat di peta."
      }
    },
    {
      "key": "help-refunds",
      "kind": "help",
      "title": {
        "en": "Cancellations and refunds",
        "ar": "الإلغاء والاسترداد",
        "id": "Pembatalan dan pengembalian dana"
      },
      "body": {
        "en": "Each service shows its cancellation policy before you pay. Refunds go back to the card or wallet you paid with. If a provider declines, you get a full refund and similar options.",
        "ar": "تعرض كل خدمة سياسة الإلغاء قبل الدفع. يُعاد المبلغ إلى البطاقة أو المحفظة التي دفعت بها. إذا رفض مقدم الخدمة، تسترد المبلغ كاملاً مع خيارات مشابهة."
      }
    }
  ]
