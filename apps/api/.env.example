# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://rafeeq:rafeeq@localhost:5432/rafeeq
REDIS_URL=redis://localhost:6379

# Demo mode: sandbox payments, test OTP codes, sample data only.
# Must stay true until the compliance checklist is done.
DEMO_MODE=true
DEMO_OTP_CODE=123456
# Testing only: log in with just a phone number or email, no code.
# Defaults to DEMO_MODE; refused when DEMO_MODE=false.
QUICK_LOGIN=true

JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=7d
# 32-byte key (base64) for encrypting IBANs and documents at rest
DATA_ENCRYPTION_KEY=

CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Background jobs (holds, timeouts, overdue bags, payouts). Tests turn them off.
JOBS_ENABLED=true
PUBLIC_WEB_URL=http://localhost:3001
# Shared secret for the SMS provider's inbound webhook (POST /v1/sms/inbound)
SMS_WEBHOOK_SECRET=dev-sms-secret
